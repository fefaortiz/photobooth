#!/usr/bin/env python3

import sys
import cv2
import pygame


CAMERA_DEVICE = "/dev/video0"
CAMERA_WIDTH = 640
CAMERA_HEIGHT = 480
TARGET_FPS = 20


def frame_to_surface(frame, screen_size):
    frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)

    # OpenCV fornece altura x largura x canais.
    # Pygame espera largura x altura x canais.
    frame = frame.swapaxes(0, 1)

    surface = pygame.surfarray.make_surface(frame)

    # Preserva a proporção da câmera.
    image_width, image_height = surface.get_size()
    screen_width, screen_height = screen_size

    scale = min(
        screen_width / image_width,
        screen_height / image_height,
    )

    new_size = (
        int(image_width * scale),
        int(image_height * scale),
    )

    return pygame.transform.smoothscale(surface, new_size)


def main():
    pygame.init()
    pygame.mouse.set_visible(False)

    screen = pygame.display.set_mode(
        (0, 0),
        pygame.FULLSCREEN,
    )

    screen_size = screen.get_size()
    clock = pygame.time.Clock()

    camera = cv2.VideoCapture(
        CAMERA_DEVICE,
        cv2.CAP_V4L2,
    )

    if not camera.isOpened():
        pygame.quit()
        raise RuntimeError(
            f"Não foi possível abrir a câmera {CAMERA_DEVICE}"
        )

    camera.set(cv2.CAP_PROP_FRAME_WIDTH, CAMERA_WIDTH)
    camera.set(cv2.CAP_PROP_FRAME_HEIGHT, CAMERA_HEIGHT)
    camera.set(cv2.CAP_PROP_FPS, TARGET_FPS)

    try:
        while True:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    return

                if (
                    event.type == pygame.KEYDOWN
                    and event.key == pygame.K_ESCAPE
                ):
                    return

            success, frame = camera.read()

            if not success:
                screen.fill((20, 20, 20))
                pygame.display.flip()
                clock.tick(5)
                continue

            surface = frame_to_surface(frame, screen_size)

            screen.fill((0, 0, 0))

            rect = surface.get_rect(
                center=screen.get_rect().center
            )

            screen.blit(surface, rect)
            pygame.display.flip()

            clock.tick(TARGET_FPS)

    finally:
        camera.release()
        pygame.quit()


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"Erro: {error}", file=sys.stderr)
        sys.exit(1)
